# Pinned inputs of the rynas-oans build (packaging/oans/build.sh, D-DEDUP,
# docs/phase2/dedup.md §1.4). One change of this file is one package release: bump
# PKG_REVISION when only the packaging changes, reset it to 1 with a new OANS_VERSION. CI
# runs check-upstream.sh; a bump runs packaging/test-dedup.sh before it is published, and
# the rynas versions accepted by rynasd (rynas_dedup::engine, MIN/MAX_MINOR) move with it.
#
# Checked on 2026-11-11:
# - oans v1.14.1 (2026-10-19) is the latest release (https://github.com/martinus/oans/releases/tag/v1.14.1),
#   tag commit below; the source tarball is GitHub's archive of the tag.
OANS_VERSION=1.14.1
OANS_COMMIT=0c0ec3a3ecf300d33b3a00cb66584e541ce8e920
OANS_SOURCE_URL=https://github.com/martinus/oans/archive/refs/tags/v1.14.1.tar.gz
OANS_SOURCE_SHA256=af72c0ef6412d745f5475fd73b59dd23edd6069b3fb84b95d93a5e4dc955aff2
# debian:trixie, multi-arch index digest of 2026-11-11 (Docker Hub)
BUILDER_IMAGE=debian:trixie@sha256:913f6706df59a68922d1dd08f78c2476560a8d367897200a6005b00e5f67c2d5
PKG_REVISION=1
# NAS CPUs (Celeron J4125 and up) all have x86-64-v2, like the rynas binaries; never -march=native
MARCH=x86-64-v2

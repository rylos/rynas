# Pinned inputs of rynas's NUT backport (packaging/nut/build.sh, D-UPS-NUT,
# docs/research/ups.md "NUT newer than Debian's"). One change of this file is one package
# release: bump PKG_REVISION when only the packaging changes, reset it to 1 with a new
# NUT_DEBIAN_VERSION. CI runs check-upstream.sh; a bump rebuilds, runs packaging/nut/test.sh
# and moves rynasd's pinned file list (crates/rynasd/src/ups_update.rs, PINNED_DEBS) with it.
#
# Checked on 2026-11-11:
# - Debian 13 (trixie) has NUT 2.8.1-5+deb13u1 and no trixie-backports; 2.8.5-1 is in
#   forky and sid (uploaded 2026-09-09, first seen by snapshot.debian.org 20260909T022729Z).
# - The source is Debian's own, unmodified: the .dsc below by SHA-256 (it lists the SHA-256
#   of the upstream tarball and of the Debian packaging, which dpkg-source checks).
NUT_DEBIAN_VERSION=2.8.5-1
NUT_DSC_URL=https://snapshot.debian.org/archive/debian/20261110T000000Z/pool/main/n/nut/nut_2.8.5-1.dsc
NUT_DSC_SHA256=eb86d8fa10341d8d032391f4cc037b0a4043b25242904bfaf624d4bd834fdb97
# debian:trixie, multi-arch index digest of 2026-11-11 (Docker Hub)
BUILDER_IMAGE=debian:trixie@sha256:913f6706df59a68922d1dd08f78c2476560a8d367897200a6005b00e5f67c2d5
# Debian archive state the build dependencies come from: the same packages on every build
# (snapshot.debian.org, checked with the image's archive keyring)
DEBIAN_SNAPSHOT=20261110T000000Z
# Version of the packages: <Debian version>~rynas13+<revision>, below Debian's own
# 2.8.5-1, so a Debian (or backports) package replaces it
PKG_REVISION=1
# The binary packages a NAS needs (upsd and the USB/serial drivers, upsmon, upsc,
# nut-scanner) and the libraries they link. Not the metapackage nut: Debian's (2.8.1)
# depends on nut-server and nut-client unversioned and stays.
PACKAGES="nut-server nut-client libupsclient7 libnutscan4"
# Parallel make jobs (each needs up to ~1 GB of RAM)
JOBS=2

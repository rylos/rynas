# Pinned inputs of rynas's NUT backport (packaging/nut/build.sh, D-UPS-NUT,
# docs/research/ups.md "NUT newer than Debian's").
#
# Built ONCE and attached to one fixed GitHub release (RELEASE_TAG below), not per rynas
# release: the packages stay as they are until Debian ships NUT >= 2.8.5 for trixie (in
# trixie-backports; rynasd then installs Debian's from apt). Rebuild only for a new NUT
# version (a new NUT_DEBIAN_VERSION, PKG_REVISION back to 1, a new release tag) or a fix of
# the packaging (PKG_REVISION + 1, new tag): any change to this folder changes the files,
# so a rebuild also means new SHA-256s in rynasd (crates/rynasd/src/ups_update.rs:
# PINNED_DEBS, RELEASE_TAG) and packaging/nut/test.sh again. CI runs check-upstream.sh.
#
# Checked on 2026-11-11:
# - Debian 13 (trixie) has NUT 2.8.1-5 (+deb13u1 pending) and no trixie-backports; 2.8.5-1
#   is in forky and sid (uploaded 2026-09-09, first seen by snapshot.debian.org
#   20260909T022729Z).
# - The source is Debian's own, unmodified: the .dsc below by SHA-256 (it lists the SHA-256
#   of the upstream tarball and of the Debian packaging, which dpkg-source checks).
NUT_DEBIAN_VERSION=2.8.5-1
NUT_DSC_URL=https://snapshot.debian.org/archive/debian/20261110T000000Z/pool/main/n/nut/nut_2.8.5-1.dsc
NUT_DSC_SHA256=eb86d8fa10341d8d032391f4cc037b0a4043b25242904bfaf624d4bd834fdb97
# debian:trixie, multi-arch index digest of 2026-11-11 (Docker Hub)
BUILDER_IMAGE=debian:trixie@sha256:913f6706df59a68922d1dd08f78c2476560a8d367897200a6005b00e5f67c2d5
# Debian archive state the build dependencies come from: the same packages on every build
# (snapshot.debian.org, checked with the image's archive keyring)
DEBIAN_SNAPSHOT=20261110T000000Z
# Version of the packages: <upstream>-0~rynas13+<revision> (2.8.5-0~rynas13+1). It sorts
# above trixie's 2.8.1-5 and BELOW every Debian build of 2.8.5-1 (the official backport
# 2.8.5-1~bpo13+1, synodeb's 2.8.5-1~synodeb13+1), so any of those replaces it.
PKG_REVISION=1
# The fixed GitHub release the packages are attached to (rynasd downloads them from it)
RELEASE_TAG=nut-2.8.5-0rynas1
# The binary packages a NAS needs (upsd and the USB/serial drivers, upsmon, upsc,
# nut-scanner) and the libraries they link. Not the metapackage nut: Debian's (2.8.1)
# depends on nut-server and nut-client unversioned and stays.
PACKAGES="nut-server nut-client libupsclient7 libnutscan4"
# Parallel make jobs (each needs up to ~1 GB of RAM)
JOBS=2

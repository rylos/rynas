#!/bin/sh
set -e

# the Synology module's UPS hook was a conffile in /etc/synodeb up to 0.1.0; rynasd now links
# it there only where synodeb runs the UPS
dpkg-maintscript-helper rm_conffile /etc/synodeb/ups-pre-safemode.d/50-rynas 0.1.0 -- "$@"

if [ "$1" = "configure" ]; then
    mkdir -p /var/lib/rynas/auth
    # system group and user of rynas-web; the group may also connect to rynasd
    if ! getent group rynas >/dev/null; then
        addgroup --system --quiet rynas
    fi
    if ! getent passwd rynas >/dev/null; then
        adduser --system --quiet --ingroup rynas --home /var/lib/rynas \
            --no-create-home --shell /usr/sbin/nologin rynas
    fi
    # members of rynas-admin (or sudo) may administer the NAS from the web
    if ! getent group rynas-admin >/dev/null; then
        addgroup --system --quiet rynas-admin
        NEW_ADMIN_GROUP=1
    fi

    # /var/lib/rynas: rynas-web may enter it, rynasd keeps its secrets in auth/
    chown root:rynas /var/lib/rynas
    chmod 0750 /var/lib/rynas
    chown root:root /var/lib/rynas/auth
    chmod 0700 /var/lib/rynas/auth

    # Debian's btrbk.service failed every night without /etc/btrbk/btrbk.conf (our drop-in
    # now skips it): clear the stale failed state
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload >/dev/null 2>&1 || true
        systemctl reset-failed btrbk.service >/dev/null 2>&1 || true
    fi

    if [ -n "${NEW_ADMIN_GROUP:-}" ]; then
        cat <<'MSG'
rynas: log in at https://<this-host>:8443/ with a system account that is a
member of the group rynas-admin or sudo, e.g.:  adduser <user> rynas-admin
The certificate comes from this NAS's own local CA: the browser warns until
you trust it (see /usr/share/doc/rynas/README.Debian, "HTTPS").
MSG
    fi
fi

#DEBHELPER#

exit 0

#!/bin/sh
set -e

dpkg-maintscript-helper rm_conffile /etc/synodeb/ups-pre-safemode.d/50-rynas 0.1.0 -- "$@"

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    # the Synology module's link into synodeb's UPS hooks (made by rynasd)
    hook=/etc/synodeb/ups-pre-safemode.d/50-rynas
    if [ -L "$hook" ] && [ "$(readlink "$hook")" = /usr/lib/rynas/modules/synology/ups-pre-safemode ]; then
        rm -f "$hook"
    fi
    # PC backup: without the filter the account must not keep its sudo rights
    rm -f /etc/sudoers.d/rynas-pcbackup /etc/sudoers.d/rynas-pcbackup.rynas-new
fi

if [ "$1" = "purge" ]; then
    # files generated by configuration applies that only rynas uses: scheduler task units
    # and their timers drop-in, btrbk configurations, the apt hook of system restore points
    # (shares, users and their system files stay: they belong to the system now). Before
    # the debhelper snippet, whose daemon-reload then forgets the removed units.
    for t in /etc/systemd/system/rynas-task-*.timer; do
        [ -e "$t" ] || continue
        if [ -d /run/systemd/system ] && command -v deb-systemd-invoke >/dev/null 2>&1; then
            deb-systemd-invoke stop "$(basename "$t")" >/dev/null 2>&1 || true
        fi
    done
    rm -f /etc/systemd/system/rynas-task-*.service /etc/systemd/system/rynas-task-*.timer \
        /etc/systemd/system/timers.target.d/rynas-tasks.conf /etc/apt/apt.conf.d/80rynas-snapshot \
        /etc/sysctl.d/60-rynas-zram.conf /etc/systemd/zram-generator.conf.d/50-rynas.conf
    rmdir /etc/systemd/system/timers.target.d 2>/dev/null || true
    rm -rf /etc/rynas
    # the journal's size limit of Storage › Space: journald reads its drop-ins when it starts
    if [ -e /etc/systemd/journald.conf.d/50-rynas-space.conf ]; then
        rm -f /etc/systemd/journald.conf.d/50-rynas-space.conf
        rmdir /etc/systemd/journald.conf.d 2>/dev/null || true
        if [ -d /run/systemd/system ]; then
            systemctl try-restart systemd-journald.service >/dev/null 2>&1 || true
        fi
    fi
fi

#DEBHELPER#

# Removes rynas's own folders, never what is mounted below them: an interrupted rollback or
# system volume setup leaves the root filesystem's top level mounted in /run/rynas, and a
# plain rm -rf would go through it. What is mounted below is unmounted first (deepest
# first); a mount that stays is skipped by --one-file-system, with its mount point.
purge_dirs() {
    for d in "$@"; do
        [ -e "$d" ] || [ -L "$d" ] || continue
        if [ -r /proc/self/mountinfo ]; then
            awk -v d="$d" 'index($5, d "/") == 1 { print $5 }' /proc/self/mountinfo | sort -r |
                while IFS= read -r m; do
                    umount "$m" >/dev/null 2>&1 || true
                done
        fi
        rm -rf --one-file-system "$d" 2>/dev/null || true
    done
}

if [ "$1" = "purge" ]; then
    # TOTP secrets, recovery codes and any other state; caches (thumbnails, the backup
    # jobs' rustic caches)
    purge_dirs /var/lib/rynas /run/rynas /var/lib/rynas-cert-drop /var/cache/rynas
    # PC backup account (its home holds only the keys file rynas wrote; the received
    # snapshots stay where they are)
    purge_dirs /var/lib/rynas-pcbackup
    if getent passwd rynas-pcbackup >/dev/null; then
        if command -v deluser >/dev/null 2>&1; then
            deluser --system --quiet rynas-pcbackup || true
        else
            userdel rynas-pcbackup || true
        fi
    fi
    if getent group rynas-pcbackup >/dev/null && command -v delgroup >/dev/null 2>&1; then
        delgroup --system --quiet rynas-pcbackup || true
    fi
    if command -v deluser >/dev/null 2>&1; then
        if getent passwd rynas >/dev/null; then
            deluser --system --quiet rynas || true
        fi
        for g in rynas-admin rynas-cert-drop rynas; do
            if getent group "$g" >/dev/null; then
                delgroup --system --quiet "$g" || true
            fi
        done
    fi
fi

exit 0

#!/bin/sh
set -e

dpkg-maintscript-helper rm_conffile /etc/synodeb/ups-pre-safemode.d/50-rynas 0.1.0 -- "$@"

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    # the Synology module's link into synodeb's UPS hooks (made by rynasd)
    hook=/etc/synodeb/ups-pre-safemode.d/50-rynas
    if [ -L "$hook" ] && [ "$(readlink "$hook")" = /usr/lib/rynas/modules/synology/ups-pre-safemode ]; then
        rm -f "$hook"
    fi
fi

if [ "$1" = "purge" ]; then
    # files generated by configuration applies that only rynas uses: scheduler task units
    # and their timers drop-in, btrbk configurations, the apt hook of system restore points
    # (shares, users and their system files stay: they belong to the system now). Before
    # the debhelper snippet, whose daemon-reload then forgets the removed units.
    for t in /etc/systemd/system/rynas-task-*.timer; do
        [ -e "$t" ] || continue
        if [ -d /run/systemd/system ] && command -v deb-systemd-invoke >/dev/null 2>&1; then
            deb-systemd-invoke stop "$(basename "$t")" >/dev/null 2>&1 || true
        fi
    done
    rm -f /etc/systemd/system/rynas-task-*.service /etc/systemd/system/rynas-task-*.timer \
        /etc/systemd/system/timers.target.d/rynas-tasks.conf /etc/apt/apt.conf.d/80rynas-snapshot
    rmdir /etc/systemd/system/timers.target.d 2>/dev/null || true
    rm -rf /etc/rynas
fi

#DEBHELPER#

if [ "$1" = "purge" ]; then
    # TOTP secrets, recovery codes and any other state
    rm -rf /var/lib/rynas /run/rynas /var/lib/rynas-cert-drop
    if command -v deluser >/dev/null 2>&1; then
        if getent passwd rynas >/dev/null; then
            deluser --system --quiet rynas || true
        fi
        for g in rynas-admin rynas-cert-drop rynas; do
            if getent group "$g" >/dev/null; then
                delgroup --system --quiet "$g" || true
            fi
        done
    fi
fi

exit 0

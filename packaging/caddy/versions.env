# Pinned inputs of the rynas-caddy build (packaging/caddy/build.sh). One change of this file
# is one package release: bump PKG_REVISION when only the packaging changes, reset it to 1
# with a new CADDY_VERSION. CI runs check-upstream.sh daily and rebuilds on a new release.
#
# Checked on 2026-11-07:
# - Caddy v2.11.9 (2026-11-05) is the latest stable release
#   (https://github.com/caddyserver/caddy/releases/tag/v2.11.9); D-PROXY: never below
#   2.11.4 (forward_auth copy_headers fixes, CVE-2026-30851).
# - Caddy's own release workflow builds with Go ~1.27.0 (go.mod: go 1.26.0); Go 1.27.3 is
#   the current Go release (https://go.dev/dl/?mode=json).
# - xcaddy v0.4.7 (2026-08-17) is the latest (https://github.com/caddyserver/xcaddy/releases).
CADDY_VERSION=2.11.9
XCADDY_VERSION=0.4.7
GO_VERSION=1.27.3
# golang:1.27.3-trixie, multi-arch index digest of 2026-11-05 (Docker Hub)
GO_IMAGE=golang:1.27.3-trixie@sha256:af1bfc2614ebb1dbd31af514b78740fd678850e76498762b425ecee4c5c6ea80
PKG_REVISION=1
# NAS CPUs (Celeron J4125 and up) all have x86-64-v2, like the rynas binaries
GOAMD64=v2

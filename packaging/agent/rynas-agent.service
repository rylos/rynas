[Unit]
Description=rynas PC backup agent
Documentation=https://github.com/rylos/rynas
Wants=network-online.target
# ordering only (harmless when absent): at shutdown the agent stops before the network
After=network-online.target tailscaled.service NetworkManager.service systemd-networkd.service

[Service]
Type=simple
ExecStart=/usr/bin/rynas-agent run
Restart=on-failure
RestartSec=30
# a backup reads everything and makes snapshots, freezes and private mounts: root, but
# nothing it does not need
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
StateDirectory=rynas-agent
StateDirectoryMode=0700
CacheDirectory=rynas-agent
CacheDirectoryMode=0700
# SIGTERM: an idle service exits at once; a running backup child is stopped first (it
# thaws and exits within seconds; the service waits for it at most 25 s)
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target

# rynas-web: HTTP API and web interface, unprivileged (user rynas). Privileged work goes
# through rynasd over /run/rynas/rynasd.sock (the rynas group may connect).
[Unit]
Description=rynas web interface
Documentation=https://github.com/rylos/rynas
After=network-online.target rynasd.service rynasd.socket
Wants=network-online.target rynasd.service

[Service]
Type=simple
User=rynas
Group=rynas
# listen addresses and extra options: /etc/default/rynas-web
Environment=RYNAS_WEB_LISTEN=0.0.0.0:8080
Environment=RYNAS_WEB_TLS_LISTEN=[::]:8443
EnvironmentFile=-/etc/default/rynas-web
ExecStart=/usr/libexec/rynas/rynas-web --listen ${RYNAS_WEB_LISTEN} --tls-listen ${RYNAS_WEB_TLS_LISTEN} --ui-dir /usr/share/rynas/ui --rynasd-socket /run/rynas/rynasd.sock $RYNAS_WEB_OPTS
# HTTPS certificate: rynasd publishes it in /etc/rynas/tls (0750 root:rynas) and rynas-web
# reloads it by itself within 10 s; a reload makes it re-read the files at once
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s
UMask=0077

# Memory and tasks (docs/quality/guidelines.md §4.1, M5, M7): idle < 12 MB, busy < 20 MB.
# The metrics ring is bounded (~1.5 MB after an hour). TasksMax: the event loop, 4 blocking
# threads, the metrics collector and at most 8 filesystem probes stuck on a hung network mount.
Environment=GLIBC_TUNABLES=glibc.malloc.mmap_threshold=262144:glibc.malloc.trim_threshold=1048576:glibc.malloc.arena_max=2
MemoryHigh=48M
MemoryMax=96M
TasksMax=32

NoNewPrivileges=yes
ProtectSystem=strict
# statvfs of /home must still work for the storage page
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=default
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
# to bind 443 directly instead of using a reverse proxy:
#AmbientCapabilities=CAP_NET_BIND_SERVICE
#CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target

[Unit]
Description=rynas task updates-check: Updates check
Documentation=https://github.com/rylos/rynas
After=local-fs.target network-online.target

[Service]
Type=exec
ExecCondition=+/usr/libexec/rynas/rynasctl gate updates-check
ExecStart=/usr/libexec/rynas/rynasctl job run updates-check
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rynas-task-updates-check
ExecStopPost=+/usr/libexec/rynas/rynasctl task-finished updates-check

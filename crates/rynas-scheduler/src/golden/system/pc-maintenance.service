[Unit]
Description=rynas task pc-maintenance: PC backup maintenance
Documentation=https://github.com/rylos/rynas
After=local-fs.target network-online.target

[Service]
Type=exec
ExecCondition=+/usr/libexec/rynas/rynasctl gate pc-maintenance
TimeoutStartSec=infinity
ExecStart=/usr/libexec/rynas/rynasctl job run pc-maintenance
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rynas-task-pc-maintenance
ExecStopPost=+/usr/libexec/rynas/rynasctl task-finished pc-maintenance

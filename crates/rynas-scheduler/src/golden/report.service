[Unit]
Description=rynas task report: report
Documentation=https://github.com/rylos/rynas
After=local-fs.target network-online.target

[Service]
Type=exec
StandardInput=file:/var/lib/rynas/tasks/report/run
ExecStart=/usr/bin/env python3 -
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rynas-task-report
ExecStopPost=+/usr/libexec/rynas/rynasctl task-finished report
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes

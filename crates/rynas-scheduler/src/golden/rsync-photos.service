[Unit]
Description=rynas task rsync-photos: rsync photos (100%% of them)
Documentation=https://github.com/rylos/rynas
After=local-fs.target network-online.target

[Service]
Type=exec
ExecCondition=+/usr/libexec/rynas/rynasctl gate rsync-photos
User=alice
StandardInput=file:/var/lib/rynas/tasks/rsync-photos/run
ExecStart=/bin/sh -
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rynas-task-rsync-photos
ExecStopPost=+/usr/libexec/rynas/rynasctl task-finished rsync-photos
RuntimeMaxSec=7200
Nice=10
IOWeight=50
NoNewPrivileges=yes
PrivateTmp=yes

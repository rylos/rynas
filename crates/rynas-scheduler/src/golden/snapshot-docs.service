[Unit]
Description=rynas task snapshot-docs: snapshot-docs
Documentation=https://github.com/rylos/rynas
After=local-fs.target network-online.target

[Service]
Type=exec
ExecCondition=+/usr/libexec/rynas/rynasctl gate snapshot-docs
ExecStart=/usr/libexec/rynas/rynasctl job run snapshot-docs
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rynas-task-snapshot-docs
ExecStopPost=+/usr/libexec/rynas/rynasctl task-finished snapshot-docs
NoNewPrivileges=yes
ProtectSystem=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_NETLINK
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_RAWIO CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_CHOWN CAP_FSETID
